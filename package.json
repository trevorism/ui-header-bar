{
  "name": "@trevorism/ui-header-bar",
  "version": "5.0.0",
  "description": "The header bar component for Trevorism.com",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "accept": "vitest run --environment jsdom",
    "dev": "vite",
    "preview": "vite preview --port 4173",
    "format": "prettier --write ./*.js",
    "test": "vitest --environment jsdom",
    "webstorm-integration": "vitest --watch --reporter=dot --reporter=json --outputFile=.vitest-result.json"
  },
  "main": "./dist/ui-header-bar.umd.js",
  "module": "./dist/ui-header-bar.es.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vue3-click-away": "^1.2.4",
    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "resize-observer-polyfill": "^1.5.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-cli-plugin-vuestic-ui": "~1.0.11",
    "vue3-cookies": "^1.0.6"
  },
  "peerDependencies": {
    "vue": "^3.5.18"
  },
  "license": "MIT",
  "repository": "trevorism/ui-header-bar"
}
