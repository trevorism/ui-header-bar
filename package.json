{
  "name": "@trevorism/ui-header-bar",
  "version": "4.0.0",
  "description": "The header bar component for Trevorism.com",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "accept": "vitest run --environment jsdom",
    "dev": "vite",
    "preview": "vite preview --port 4173",
    "format": "prettier --write ./*.js",
    "test": "vitest --environment jsdom",
    "webstorm-integration": "vitest --watch --reporter=dot --reporter=json --outputFile=.vitest-result.json"
  },
  "main": "./dist/ui-header-bar.umd.js",
  "module": "./dist/ui-header-bar.es.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue3-click-away": "^1.2.4",
    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.13.0",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "resize-observer-polyfill": "^1.5.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-cli-plugin-vuestic-ui": "~1.0.11",
    "vue3-cookies": "^1.0.6"
  },
  "peerDependencies": {
    "vue": "^3.5.18"
  },
  "license": "MIT",
  "repository": "trevorism/ui-header-bar"
}
